# Copy to .env.local and fill in. All VITE_ values are PUBLIC (shipped to the browser).
# The OpenAI key is NOT set here: the host enters it on the /host setup page and it is
# stored only in that browser. (Optional, local dev only: VITE_OPENAI_API_KEY below is read
# by `pnpm dev` but stripped from production builds. NEVER add it to Netlify.)

# "local" = play in tabs of one browser, no Supabase needed. "supabase" = real phones over internet.
VITE_TRANSPORT=local

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Spotify app Client ID (PKCE flow, no client secret needed)
VITE_SPOTIFY_CLIENT_ID=
# Redirect URI is automatic: <current site>/callback. Add both
# http://127.0.0.1:5173/callback and https://<site>.netlify.app/callback in the Spotify dashboard.
VITE_ENABLE_SPOTIFY_WEB_PLAYBACK=true

# Local dev only (ignored in production builds):
# VITE_OPENAI_API_KEY=sk-...